{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run format:check *)",
      "Bash(npm run format *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(npm run db:clear*)",
      "Bash(node scripts/clear-db.js*)",
      "Bash(firebase deploy*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(git push --force*)",
      "Read(./.env)",
      "Read(./.env.production)",
      "Read(./.env.vercel)",
      "Read(./.env.local)"
    ]
  }
}
