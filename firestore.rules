rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Emergency bootstrap for the first administrator. This also lets the
    // existing admin create their users/{uid} profile if it does not exist yet.
    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@sunflower.com';
    }

    function hasUserProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActive() {
      return isBootstrapAdmin()
        || (hasUserProfile()
          && userProfile().active == true);
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isActive()
          && userProfile().role == 'admin');
    }

    function hasPage(pageId) {
      return isAdmin()
        || (isActive()
          && userProfile().keys().hasAll(['allowedPages'])
          && userProfile().allowedPages is list
          && pageId in userProfile().allowedPages);
    }

    function canUseCrm() {
      return hasPage('crm')
        || hasPage('leads')
        || hasPage('customer_data')
        || hasPage('sales');
    }

    function canUseOrderFlow() {
      return hasPage('sales')
        || hasPage('design')
        || hasPage('purchase')
        || hasPage('production')
        || hasPage('delivery')
        || hasPage('accounting');
    }

    function canUseDesign() {
      return hasPage('sales') || hasPage('design');
    }

    function canManageProduction() {
      return isAdmin() || (hasPage('production') && userProfile().role == 'producer');
    }

    function canUsePurchase() {
      return hasPage('purchase') || hasPage('inventory');
    }

    function canUseInventory() {
      return hasPage('purchase')
        || hasPage('inventory')
        || hasPage('production');
    }

    function canUseAccounting() {
      return hasPage('sales')
        || hasPage('purchase')
        || hasPage('accounting');
    }

    function isValidRole(role) {
      return role in [
        'admin',
        'sale',
        'designer',
        'purchaser',
        'producer',
        'accountant'
      ];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'active',
          'allowedPages'
        ])
        && data.uid is string
        && data.email is string
        && data.displayName is string
        && isValidRole(data.role)
        && data.active is bool
        && data.allowedPages is list;
    }

    // Profile administration is server-only. Firebase Admin SDK bypasses these
    // client rules after the API has verified the caller's ID token and role.
    // The single exception lets the first real administrator create their own
    // canonical users/{authUid} profile during initial bootstrap.
    match /users/{userId} {
      allow read: if isActive();
      allow create: if isBootstrapAdmin()
        && userId == request.auth.uid
        && userId == request.resource.data.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && isValidUserProfile(request.resource.data);
      allow update, delete: if false;
    }

    // Catalog mutations use the authenticated API (uniqueness, revision and source validation).
    function canManageItemCatalog() {
      return isAdmin() || (isActive() && (
        (userProfile().role == 'purchaser' && (hasPage('inventory') || hasPage('purchase')))
        || (userProfile().role == 'accountant' && hasPage('accounting'))
      ));
    }

    // Warehouse readers see the catalog and its customer links on the live Kho vật tư page.
    match /item_catalog/{documentId} {
      allow read: if canManageItemCatalog() || canReadWarehouse();
      allow write: if false;
    }
    match /catalog_links/{documentId} {
      allow read: if canManageItemCatalog() || canReadWarehouse();
      allow write: if false;
    }
    match /catalog_requests/{documentId} {
      allow read: if canManageItemCatalog();
      allow write: if false;
    }

    // CRM and lead management.
    match /customers/{documentId} {
      allow read: if isActive()
        && (isAdmin()
          || userProfile().role != 'sale'
          || resource.data.assignedSaleId == request.auth.uid);
      // The short code of item codes (D-MA1) is reserved once by the catalog API and never written by a client.
      allow create: if (hasPage('crm') || hasPage('sales'))
        && !request.resource.data.keys().hasAny(['financeLinked', 'shortCode', 'shortCodeSetAt', 'shortCodeSetById'])
        && (isAdmin()
          || userProfile().role != 'sale'
          || request.resource.data.assignedSaleId == request.auth.uid);
      allow update: if (hasPage('crm') || hasPage('sales'))
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['financeLinked', 'shortCode', 'shortCodeSetAt', 'shortCodeSetById'])
        && (isAdmin()
          || userProfile().role != 'sale'
          || (resource.data.assignedSaleId == request.auth.uid
            && request.resource.data.assignedSaleId == resource.data.assignedSaleId));
      allow delete: if isAdmin() && resource.data.get('financeLinked', false) != true;
    }

    match /leads/{documentId} {
      allow get: if isActive()
        && (isAdmin()
          || userProfile().role != 'sale'
          || !exists(/databases/$(database)/documents/leads/$(documentId))
          || resource.data.assignedSaleId == request.auth.uid);
      allow list: if isActive()
        && (isAdmin()
          || userProfile().role != 'sale'
          || resource.data.assignedSaleId == request.auth.uid);
      allow create: if (hasPage('leads') || hasPage('crm'))
        && (isAdmin()
          || userProfile().role != 'sale'
          || request.resource.data.assignedSaleId == request.auth.uid);
      allow update: if (hasPage('leads') || hasPage('crm'))
        && (isAdmin()
          || userProfile().role != 'sale'
          || (resource.data.assignedSaleId == request.auth.uid
            && request.resource.data.assignedSaleId == resource.data.assignedSaleId));
      allow delete: if isAdmin();
    }

    match /lead_candidates/{documentId} {
      allow get: if isActive()
        && canUseCrm()
        && (isAdmin()
          || userProfile().role != 'sale'
          || !exists(/databases/$(database)/documents/lead_candidates/$(documentId))
          || resource.data.assignedSaleId == request.auth.uid);
      allow list: if isActive()
        && canUseCrm()
        && (isAdmin()
          || userProfile().role != 'sale'
          || resource.data.assignedSaleId == request.auth.uid);
      allow create: if canUseCrm()
        && (isAdmin()
          || (request.resource.data.assignedSaleId == request.auth.uid
            && (!('taskSource' in request.resource.data)
              || request.resource.data.taskSource != 'admin_assigned')
            && (!('taskAssignedById' in request.resource.data)
              || request.resource.data.taskAssignedById == ''
              || request.resource.data.taskAssignedById == request.auth.uid)));
      allow update: if isAdmin()
        || (canUseCrm()
          && resource.data.assignedSaleId == request.auth.uid
          && request.resource.data.assignedSaleId == resource.data.assignedSaleId
          && (!('taskSource' in resource.data)
            || resource.data.taskSource != 'admin_assigned'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'taskSource',
              'taskAssignedAt',
              'taskAssignedById',
              'taskAssignedByName'
            ]))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'taskSource',
              'taskAssignedAt',
              'taskAssignedById',
              'taskAssignedByName'
            ])
            || (request.resource.data.taskSource == 'sale_created'
              && request.resource.data.taskAssignedById == request.auth.uid)));
      allow delete: if isAdmin();
    }

    match /lead_filter_definitions/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /customer_filter_definitions/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /system_filter_definitions/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /lead_profile_field_definitions/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /entity_field_definitions/{documentId} {
      allow read: if isActive();
      // Metadata writes go through the admin API (type locks, usage checks, audit).
      allow create, update, delete: if false;
    }

    match /entity_system_field_overrides/{documentId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // One company-wide layout per table. Employees may consume layouts, but
    // only an authenticated administrator may change order, visibility or width.
    match /table_column_layouts/{documentId} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && documentId.matches('^[a-zA-Z0-9:_-]{1,180}$')
        && request.resource.data.keys().hasAll(['id', 'schemaVersion', 'updatedAt', 'updatedById'])
        && request.resource.data.keys().hasOnly(['id', 'schemaVersion', 'selectedIds', 'widths', 'updatedAt', 'updatedById', 'createdAt'])
        && request.resource.data.id == documentId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedById == request.auth.uid
        && (!('selectedIds' in request.resource.data)
          || (request.resource.data.selectedIds is list && request.resource.data.selectedIds.size() <= 256))
        && (!('widths' in request.resource.data)
          || (request.resource.data.widths is map && request.resource.data.widths.size() <= 256));
      allow delete: if false;
    }

    match /raw_data_priority_rules/{documentId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /raw_data_scoring_rules/{documentId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Sale PO is shared by all downstream departments because every team
    // updates its own stage on the same order document.
    match /pos/{documentId} {
      allow read: if isActive();
      // Production allocation and its scope are owned by the transactional API.
      allow create: if canUseOrderFlow()
        && !request.resource.data.keys().hasAny(['productionPlanRequiredItemIds', 'productionPlanLocked', 'productionPlanFrozen', 'productionRevision', 'goodsFlowVersion', 'goodsRevision', 'goodsReady', 'goodsDeliveryClosed', 'accountingFlowVersion', 'accountingRevision', 'accountingProgress']);
      allow update: if canUseOrderFlow()
        && (request.resource.data.status == resource.data.status || !(request.resource.data.status in ['waiting_receivable', 'waiting_discount', 'invoiced', 'debt_collected']))
        && (resource.data.get('accountingFlowVersion', 0) != 1 || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'items', 'customerId', 'deleted']))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['goodsFlowVersion', 'goodsRevision', 'goodsReady', 'goodsDeliveryClosed', 'accountingFlowVersion', 'accountingRevision', 'accountingProgress'])
        && (resource.data.get('goodsFlowVersion', 0) != 1
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['items', 'status', 'customerId', 'deliveryStage', 'deliveryProgress', 'deleted']))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['productionPlanRequiredItemIds', 'productionPlanLocked', 'productionPlanFrozen', 'productionRevision'])
        && (resource.data.get('productionPlanLocked', false) != true
          || ((resource.data.get('productionPlanFrozen', false) != true || request.resource.data.items == resource.data.items)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['productionProgress', 'deleted'])
            && (resource.data.status != 'waiting_production' || request.resource.data.status == resource.data.status)));
      allow delete: if isAdmin() && resource.data.get('productionPlanLocked', false) != true && resource.data.get('goodsFlowVersion', 0) != 1 && resource.data.get('accountingFlowVersion', 0) != 1;
    }

    // Design workflow. Sale can create requests; design staff process them.
    match /design_requests/{documentId} {
      allow read: if isActive();
      allow create, update: if canUseDesign();
      allow delete: if isAdmin();
    }

    match /designs/{documentId} {
      allow read: if isActive();
      allow create, update: if canUseDesign();
      allow delete: if isAdmin();
    }

    // Purchasing and supplier management.
    match /suppliers/{documentId} {
      allow read: if isActive();
      allow create: if hasPage('purchase') && !request.resource.data.keys().hasAny(['financeLinked']);
      allow update: if hasPage('purchase') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['financeLinked']);
      allow delete: if isAdmin() && resource.data.get('financeLinked', false) != true;
    }

    match /procurement_requests/{documentId} {
      allow read: if isActive();
      allow create: if (hasPage('sales') || hasPage('purchase'))
        && !request.resource.data.keys().hasAny(['warehouseReceiptRevision', 'goodsReceiptRevision']);
      allow update: if (hasPage('sales') || hasPage('purchase'))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['warehouseReceiptRevision', 'goodsReceiptRevision'])
        && !(resource.data.get('purchaseOrderId', '') != ''
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'purchaseOrderId', 'sourcingType', 'deleted']));
      allow delete: if isAdmin() && resource.data.get('purchaseOrderId', '') == '';
    }

    match /purchase_orders/{documentId} {
      allow read: if isActive();
      allow create: if canUsePurchase()
        && !request.resource.data.keys().hasAny(['warehouseReceiptRevision', 'warehouseReceivedComplete', 'goodsFlowVersion', 'goodsReceiptRevision'])
        && request.resource.data.status == 'ordered';
      // Quantity receipt/direct-shipping state and its source are server-owned.
      allow update, delete: if false;
    }

    // Legacy quantities are frozen for reconciliation; all new postings use the API.
    match /inventory/{documentId} {
      allow read: if isActive();
      allow write: if false;
    }

    match /warehouse_exports/{documentId} {
      allow read: if isActive();
      allow write: if false;
    }

    function canReadWarehouse() {
      return isAdmin() || (isActive() && (
        (userProfile().role == 'accountant' && hasPage('accounting'))
        || (userProfile().role == 'purchaser' && (hasPage('inventory') || hasPage('purchase')))
        || (userProfile().role == 'producer' && hasPage('production'))
      ));
    }
    match /warehouse_balances/{documentId} {
      allow read: if canReadWarehouse();
      allow write: if false;
    }
    // Quantity-only vouchers of both stores; posting and reversal stay on the warehouse APIs.
    match /warehouse_vouchers/{documentId} {
      allow read: if canReadWarehouse();
      allow write: if false;
    }
    // Báo cáo compares these recorded goods states with the orders; Admin and Kế toán read them like the ledger.
    match /warehouse_source_state/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /warehouse_requests/{documentId} { allow read, write: if false; }
    match /warehouse_counters/{documentId} { allow read, write: if false; }
    // Read by Báo cáo for Admin and Kế toán, as the old report API returned them.
    match /goods_order_state/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /goods_source_state/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /goods_dispatch_state/{documentId} { allow read, write: if false; }
    match /goods_requests/{documentId} { allow read, write: if false; }
    match /goods_counters/{documentId} { allow read, write: if false; }

    // Production planning and machines.
    match /production_counters/{documentId} {
      allow read, write: if false;
    }
    match /production_commands/{documentId} {
      allow read: if isActive();
      allow create: if false;
      allow update: if canManageProduction()
        && resource.data.get('productionOrderVersion', 0) != 2
        && request.resource.data.get('productionOrderVersion', 0) != 2;
      allow delete: if isAdmin() && resource.data.get('productionOrderVersion', 0) != 2;
    }

    match /machines/{documentId} {
      allow read: if isActive();
      allow create, update: if canManageProduction();
      allow delete: if isAdmin();
    }

    // Delivery management.
    match /deliveries/{documentId} {
      allow read: if isActive();
      allow create: if hasPage('delivery') && request.resource.data.status == 'planning'
        && !request.resource.data.keys().hasAny(['goodsFlowVersion', 'goodsRevision']);
      allow update: if hasPage('delivery') && resource.data.get('goodsFlowVersion', 0) != 1
        && request.resource.data.status == resource.data.status
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['goodsFlowVersion', 'goodsRevision']);
      allow delete: if isAdmin() && resource.data.get('goodsFlowVersion', 0) != 1;
    }

    match /delivery_vehicles/{documentId} {
      allow read: if isActive();
      allow create: if hasPage('delivery') && !request.resource.data.keys().hasAny(['activeGoodsTripId']);
      allow update: if hasPage('delivery')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeGoodsTripId'])
        && (resource.data.get('activeGoodsTripId', '') == ''
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'deleted']));
      allow delete: if isAdmin() && resource.data.get('activeGoodsTripId', '') == '';
    }

    // Legacy invoices are read-only; new charge projections are written by the financial API.
    match /invoices/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if false;
    }

    // Sổ công nợ reads its ledger directly; only Admin and Kế toán with the accounting page, as the API allows.
    // Every financial write, and the request/counter bookkeeping, stays on /api/accounting/manage.
    function canUseLedger() {
      return isAdmin()
        || (isActive() && userProfile().role == 'accountant' && hasPage('accounting'));
    }
    match /finance_control/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /finance_documents/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /finance_funds/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /finance_entries/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /finance_source_state/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /finance_periods/{documentId} {
      allow read: if canUseLedger();
      allow write: if false;
    }
    match /finance_requests/{documentId} { allow read, write: if false; }
    match /finance_reference_keys/{documentId} { allow read, write: if false; }
    match /finance_counters/{documentId} { allow read, write: if false; }

    // Each click to call is an independent event. Only its caller (or an admin)
    // may later confirm the result; the original call identity remains immutable.
    match /call_history/{documentId} {
      allow read: if isActive() && (hasPage('customer_data') || canUseCrm());
      allow create: if isActive()
        && (hasPage('customer_data') || canUseCrm())
        && (isAdmin() || userProfile().role == 'sale')
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.source in ['dial', 'manual']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && ((request.resource.data.source == 'dial'
            && request.resource.data.result == 'pending'
            && request.resource.data.note == ''
            && request.resource.data.confirmedAt == ''
            && request.resource.data.confirmedById == '')
          || (request.resource.data.source == 'manual'
            && request.resource.data.result in [
              'discussed', 'no_answer', 'busy', 'callback', 'wrong_number', 'not_interested'
            ]
            && request.resource.data.confirmedAt is string
            && request.resource.data.confirmedById == request.auth.uid))
        && request.resource.data.subjectKey is string
        && request.resource.data.companyName is string
        && request.resource.data.phone is string
        && request.resource.data.startedAt is string;
      allow update: if isActive()
        && (isAdmin() || resource.data.createdById == request.auth.uid)
        && resource.data.result == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'result', 'note', 'confirmedAt', 'confirmedById', 'confirmedByName', 'updatedAt'
        ])
        && request.resource.data.result in [
          'discussed', 'no_answer', 'busy', 'callback', 'wrong_number', 'not_interested'
        ]
        && request.resource.data.confirmedById == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500;
      allow delete: if false;
    }

    // Shared work calendar. Admin assigns and manages schedules; employees
    // can create and maintain their own tasks.
    match /work_schedule_items/{documentId} {
      function validWorkAssignee() {
        return request.resource.data.assigneeId is string
          && exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeId))
          && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)).data.active == true;
      }

      function validStaffAssignment() {
        return request.resource.data.assignedById == request.auth.uid
          && validWorkAssignee()
          && (
            (request.resource.data.groupId == 'self'
              && request.resource.data.assigneeId == request.auth.uid
              && request.resource.data.taskType == 'personal_task')
            || (request.resource.data.groupId == 'staff_to_company'
              && request.resource.data.taskType == 'support_request'
              && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)).data.role == 'admin')
            || (request.resource.data.groupId == 'staff_to_staff'
              && request.resource.data.taskType == 'assigned_task'
              && request.resource.data.assigneeId != request.auth.uid
              && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)).data.role != 'admin')
          );
      }

      allow read: if isAdmin()
        || (isActive() && (resource.data.assigneeId == request.auth.uid
          || resource.data.assignedById == request.auth.uid));
      allow create: if isAdmin()
        || (isActive() && validStaffAssignment());
      allow update: if isAdmin()
        || (isActive()
          && resource.data.assigneeId == request.auth.uid
          && request.resource.data.assigneeId == resource.data.assigneeId
          && request.resource.data.assignedById == resource.data.assignedById
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'stage', 'startAt', 'endAt',
            'status', 'progress', 'referenceType', 'referenceId',
            'referenceLabel', 'notes', 'completedAt', 'updatedAt',
            'cannotProcessNote', 'cannotProcessAt',
            'cannotProcessById', 'cannotProcessByName',
            'workType', 'priority', 'deleted', 'deletedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /work_schedule_groups/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    // Internal collaboration and per-user workflow notifications.
    match /channels/{documentId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isActive()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();
    }

    match /messages/{documentId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isAdmin()
        || (isActive()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId);
      allow delete: if isAdmin();
    }

    match /notifications/{documentId} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Activity monitoring is append-only. A user can only create entries under
    // their own authenticated identity; administrators can review the history.
    // This deliberately excludes passwords, tokens and any data outside ERP.
    match /audit_events/{eventId} {
      allow create: if isActive()
        && request.resource.data.id == eventId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'id', 'actorId', 'actorName', 'actorRole', 'sessionId', 'category',
          'module', 'action', 'summary', 'occurredAt', 'createdAt'
        ]);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Presence is a lightweight "last active" indicator rather than employee
    // surveillance. Each account can update only its own document.
    match /user_presence/{userId} {
      allow create, update: if isActive()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId', 'displayName', 'role', 'status', 'sessionId',
          'lastSeenAt', 'updatedAt'
        ]);
      allow read: if isAdmin() || (isActive() && userId == request.auth.uid);
      allow delete: if false;
    }

    match /reminders/{documentId} {
      allow read, create, update: if isActive();
      allow delete: if isActive();
    }

    // Master data changes are restricted to the administrator. Other users
    // submit an edit request for review.
    match /product_classifications/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /wind_directions/{documentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /edit_requests/{documentId} {
      allow read: if isActive();
      allow create: if canUseCrm();
      allow update, delete: if isAdmin();
    }

    // Attendance is written only by the authenticated API, where Admin and Kế toán record it.
    // Reads mirror that API: recorders read everyone, staff read only documents carrying their own
    // userId, so their queries must filter on userId. The company day-off calendar is not private.
    function canRecordAttendance() {
      return hasUserProfile()
        && userProfile().active == true
        && userProfile().role in ['admin', 'accountant'];
    }
    function ownsAttendanceRecord() {
      return isActive() && resource.data.userId == request.auth.uid;
    }
    match /attendance_sheets/{documentId} {
      allow read: if canRecordAttendance() || ownsAttendanceRecord();
      allow write: if false;
    }
    match /attendance_profiles/{documentId} {
      allow read: if canRecordAttendance() || ownsAttendanceRecord();
      allow write: if false;
    }
    match /attendance_calendars/{documentId} {
      allow read: if isActive();
      allow write: if false;
    }
    match /attendance_requests/{documentId} {
      allow read, write: if false;
    }
    // Retired collections of the self-service flow stay closed until they are removed.
    match /attendance_months/{documentId} {
      allow read, write: if false;
    }
    match /attendance_settings/{documentId} {
      allow read, write: if false;
    }

    // D-MA1: document codes PREFIX-YYMM-NNNN come from monthly counters that only ever move up by one, so two
    // users never receive the same number and a number is never handed out again. Browsers issue order, purchase
    // request, purchase order and delivery trip codes; stock voucher (PN/PX) and LSX counters are server-only.
    function canIssueDocumentCode(counterKey) {
      return (counterKey.matches('^(DH|YCM)-[0-9]{4}$') && canUseOrderFlow())
        || (counterKey.matches('^DM-[0-9]{4}$') && canUsePurchase())
        || (counterKey.matches('^GH-[0-9]{4}$') && hasPage('delivery'));
    }
    match /code_counters/{counterKey} {
      allow read: if isActive();
      allow create: if canIssueDocumentCode(counterKey)
        && request.resource.data.keys().hasOnly(['sequence', 'updatedAt'])
        && request.resource.data.sequence == 1;
      allow update: if canIssueDocumentCode(counterKey)
        && request.resource.data.keys().hasOnly(['sequence', 'updatedAt'])
        && request.resource.data.sequence == resource.data.sequence + 1;
      allow delete: if false;
    }

    // Any collection not reviewed above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
