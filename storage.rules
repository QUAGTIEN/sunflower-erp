rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.email == 'admin@sunflower.com'
          || firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.role == 'admin');
    }

    match /chat_attachments/{channelId}/{messageId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.senderId == request.auth.uid
        && request.resource.metadata.channelId == channelId
        && request.resource.metadata.messageId == messageId;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.metadata.senderId == request.auth.uid || isAdmin());
    }
  }
}
